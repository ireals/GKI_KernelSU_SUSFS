# TCP BBR 拥塞控制配置片段
# 由 build.yml 工作流在构建时追加到 gki_defconfig
#
# 启用 BBR 拥塞控制算法及配套的 FQ 队列调度器，
# 并将其设置为系统默认，实现开箱即用的 BBR 加速。
#
# 运行时仍可通过以下方式切换/确认：
#   sysctl net.ipv4.tcp_congestion_control=bbr
#   sysctl net.core.default_qdisc=fq

# 暴露高级拥塞控制选项（BBR 必需）
CONFIG_TCP_CONG_ADVANCED=y
# 编译进内核的 BBR 拥塞控制算法
CONFIG_TCP_CONG_BBR=y
# FQ 队列调度器，为 BBR 提供 pacing 支持
CONFIG_NET_SCH_FQ=y
# 将 BBR 设为默认拥塞控制算法
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
# 将 FQ 设为默认队列调度器
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
