diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
index c94702b..ce2641a 100644
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -77,13 +77,12 @@ static write_op_fn *context_write, *access_write;
 static write_op_fn orig_context_write, orig_access_write;
 
 #ifdef CONFIG_KSU_SUSFS
-static u32 ksu_selinux_hide_access_seqno(void)
+#define KSU_SELINUX_HIDE_CLEAN_SEQUENCE 4U
+#define KSU_SELINUX_HIDE_CLEAN_POLICYLOAD 1U
+
+static struct selinux_kernel_status *ksu_selinux_hide_status(void)
 {
-    struct selinux_kernel_status *status;
     struct page *status_page;
-    u32 sequence;
-    u32 policyload;
-    int i;
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
     status_page = selinux_kernel_status_page();
@@ -91,22 +90,39 @@ static u32 ksu_selinux_hide_access_seqno(void)
     status_page = selinux_kernel_status_page(&selinux_state);
 #endif
     if (!status_page)
-        return 0;
+        return NULL;
+
+    return page_address(status_page);
+}
+
+void ksu_selinux_hide_sync_status(void)
+{
+    struct selinux_kernel_status *status = ksu_selinux_hide_status();
 
-    status = page_address(status_page);
     if (!status)
-        return 0;
+        return;
 
-    for (i = 0; i < 3; i++) {
-        sequence = READ_ONCE(status->sequence);
-        smp_rmb();
-        policyload = READ_ONCE(status->policyload);
-        smp_rmb();
-        if (!(sequence & 1) && sequence == READ_ONCE(status->sequence))
-            return policyload;
-    }
+    if (READ_ONCE(status->sequence) == KSU_SELINUX_HIDE_CLEAN_SEQUENCE &&
+        READ_ONCE(status->policyload) == KSU_SELINUX_HIDE_CLEAN_POLICYLOAD &&
+        READ_ONCE(status->enforcing) == 1 && READ_ONCE(status->deny_unknown) == 1)
+        return;
+
+    WRITE_ONCE(status->sequence, KSU_SELINUX_HIDE_CLEAN_SEQUENCE - 1);
+    smp_wmb();
+    WRITE_ONCE(status->enforcing, 1);
+    WRITE_ONCE(status->policyload, KSU_SELINUX_HIDE_CLEAN_POLICYLOAD);
+    WRITE_ONCE(status->deny_unknown, 1);
+    smp_wmb();
+    WRITE_ONCE(status->sequence, KSU_SELINUX_HIDE_CLEAN_SEQUENCE);
 
-    return READ_ONCE(status->policyload);
+    pr_info_once("selinux_hide: normalized status sequence=%u policyload=%u\n",
+                 KSU_SELINUX_HIDE_CLEAN_SEQUENCE, KSU_SELINUX_HIDE_CLEAN_POLICYLOAD);
+}
+
+static u32 ksu_selinux_hide_access_seqno(void)
+{
+    ksu_selinux_hide_sync_status();
+    return KSU_SELINUX_HIDE_CLEAN_POLICYLOAD;
 }
 #endif
 
@@ -350,6 +366,7 @@ static int ksu_selinux_hide_enable()
     }
 #else
     pr_info("selinux_hide: setprocattr handled by SUSFS LSM hook\n");
+    ksu_selinux_hide_sync_status();
 #endif
 
     return 0;
